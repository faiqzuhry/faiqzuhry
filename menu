# -------------------- CONFIG --------------------
config_menu() {
    while :; do
        select_menu "SERVER CONFIGURATION" \
            "Backup / Restore" "Auto Reboot" "Manajemen Akun" "Hapus User" \
            "Renew User" "Reset Usage" "Cek Status User" "Cek Login Xray" \
            "Buat Token API" "Cek Log Xray" "Cek Error Xray" "Cek Log Nginx" \
            "Cek RAM" "Set Limit Xray" "Benchmark VPS" "Ganti Xray Core" \
            "WARP" "Routing" "Lihat Routing" "Ganti Domain"

        case "$MENU_CHOICE" in
            1) run_cmd "menu-backup" ;;
            2) run_cmd "menu-reboot" ;;
            3) run_cmd "menu-akun" ;;
            4) 
                cleanup; clear
                read -rp "Masukkan Username yang akan dihapus: " u
                [ -n "$u" ] && run_cmd "hapus '$u'"
                ;;
            5) 
                cleanup; clear
                read -rp "Masukkan Username: " u
                read -rp "Expired baru (hari): " d
                [ -n "$u" ] && [ -n "$d" ] && run_cmd "renew '$u' '$d'"
                ;;
            6) 
                cleanup; clear
                read -rp "Masukkan Username: " u
                [ -n "$u" ] && run_cmd "resetusage '$u'"
                ;;
            7) 
                cleanup; clear
                read -rp "Masukkan Username: " u
                [ -n "$u" ] && run_cmd "status '$u'"
                ;;
            8) run_cmd "ceklogin" ;;
            9) run_cmd "buat_token" ;;
            10) run_cmd "ceklog" ;;
            11) run_cmd "cekerror" ;;
            12) run_cmd "ceknginx" ;;
            13) run_cmd "ram" ;;
            14) run_cmd "setlimit" ;;
            15) run_cmd "bench" ;;
            16) run_cmd "ganticore" ;;
            17) run_cmd "warp" ;;
            18) run_cmd "routing" ;;
            19) run_cmd "seeroute" ;;

            20)
                cleanup
                clear
                if command -v ganti_domain >/dev/null 2>&1; then
                    ganti_domain
                elif [ -x /root/ganti_domain ]; then
                    /root/ganti_domain
                else
                    echo
                    echo "Error: ganti_domain tidak ditemukan."
                    echo
                    echo "Pastikan file tersedia di:"
                    echo "  /root/ganti_domain"
                    echo
                fi
                read -rp "Tekan ENTER untuk kembali..."
                ;;

            *) return ;;
        esac
    done
}

# -------------------- MARZBAN --------------------
marzban_menu() {
    while :; do
        select_menu "MARZBAN CONTROL" \
            "Start Marzban" "Stop Marzban" "Restart Marzban" \
            "Status Marzban" "Logs Marzban" "Update Marzban" \
            "Buat Admin Sudo" "List Admin" "List User" "Rebuild"

        case "$MENU_CHOICE" in
            1) run_cmd "marzban up" ;;
            2) run_cmd "marzban down" ;;
            3) run_cmd "marzban restart" ;;
            4) run_cmd "marzban status" ;;
            5) run_cmd "marzban logs" ;;
            6) run_cmd "marzban update" ;;
            7) run_cmd "marzban cli admin create --sudo" ;;
            8) run_cmd "marzban cli admin list" ;;
            9) run_cmd "marzban cli user list" ;;
            10)
                cleanup
                clear
                if [ -x /usr/local/bin/rebuild ]; then
                    /usr/local/bin/rebuild
                else
                    echo
                    echo "Error: /usr/local/bin/rebuild tidak ditemukan."
                    echo "Silakan install file rebuild terlebih dahulu."
                    echo
                fi
                pause_menu
                ;;
            *) return ;;
        esac
    done
}

# -------------------- INFO --------------------
info_menu() {
    cleanup
    status
    clear
    printf '\n%b── %bSERVER INFORMATION%b ──%b\n\n' "$CYAN" "$WHITE" "$RESET" "$CYAN"
    printf '%bIP       : %b%s%b\n' "$CYAN" "$WHITE" "${IP:--}" "$RESET"
    printf '%bDomain   : %b%s%b\n' "$CYAN" "$WHITE" "${domain:--}" "$RESET"
    printf '%bWARP     : %b%s%b\n' "$CYAN" "$RESET" "$WARP" "$RESET"
    printf '%bUFW      : %b%s%b\n' "$CYAN" "$RESET" "$UFW" "$RESET"
    printf '%bFail2Ban : %b%s%b\n' "$CYAN" "$RESET" "$F2B" "$RESET"
    printf '%bRAM      : %b%s%b\n' "$CYAN" "$WHITE" "${RAM:--}" "$RESET"
    printf '%bDisk     : %b%s%b\n' "$CYAN" "$WHITE" "${DISK:--}" "$RESET"
    printf '%bUptime   : %b%s%b\n' "$CYAN" "$WHITE" "${UPTIME:--}" "$RESET"
    printf '%bTimezone : %b%s%b\n' "$CYAN" "$WHITE" "$(timedatectl show -p Timezone --value 2>/dev/null || echo Asia/Jakarta)" "$RESET"
    pause_menu
}

# -------------------- MAIN LOOP --------------------
while :; do
    select_menu "MAIN MENU" \
        "Tambah User" \
        "Konfigurasi Server" \
        "Marzban Control" \
        "Informasi Server" \
        "Keluar"

    case "$MENU_CHOICE" in
        1) user_menu ;;
        2) config_menu ;;
        3) marzban_menu ;;
        4) info_menu ;;
        5|0) cleanup; clear; exit 0 ;;
    esac
done

