# Function to prompt for reboot
prompt_reboot() {
  while true; do
    echo -e "${RED}➽ Reboot VPS nya yuk biar sukses! (y/n):${NC} "
    read reboot_choice
    case $reboot_choice in
      y|Y) reboot; break ;;
      n|N) exit 0 ;;
      *) echo "➽ Pilihan tidak valid, coba lagi." ;;
    esac
  done
}

