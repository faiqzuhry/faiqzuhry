#!/bin/bash

if [ "$(id -u)" != "0" ]; then
    echo "Error: Skrip ini harus dijalankan sebagai root."
    exit 1
fi

# Install curl if not installed
apt update && apt install curl -y

# Download the reinstall script
curl -fsSL -o reinstall.sh https://raw.githubusercontent.com/bin456789/reinstall/main/reinstall.sh

# Define colors
YELLOW='\033[1;33m'
RED='\033[1;31m'
GREEN='\033[1;32m'
CYAN='\033[0;36m';
BLUE='\033[1;34m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

# Print main menu

# ========================= SAFE REBUILD GUARD =========================
REINSTALL_URL="https://raw.githubusercontent.com/bin456789/reinstall/main/reinstall.sh"
REINSTALL_FILE="/root/reinstall.sh"
REBUILD_LOG="/root/rebuild.log"

die() {
    echo -e "\033[1;31mERROR:\033[0m $*" >&2
    exit 1
}

check_rebuild_environment() {
    command -v curl >/dev/null 2>&1 || die "curl tidak tersedia."
    command -v awk >/dev/null 2>&1 || die "awk tidak tersedia."
    command -v ip >/dev/null 2>&1 || die "iproute2/ip tidak tersedia."

    [ -e /sys/class/dmi/id/product_name ] || true

    # OpenVZ/LXC tidak didukung oleh reinstall.sh upstream.
    if grep -qaE '(^|[[:space:]])(lxc|openvz)([[:space:]]|$)' /proc/1/cgroup 2>/dev/null ||
       grep -qiE 'lxc|openvz' /proc/version 2>/dev/null; then
        die "VPS terdeteksi/terindikasi OpenVZ atau LXC. Reinstall dibatalkan."
    fi

    local mem_kb disk_avail
    mem_kb=$(awk '/MemTotal:/ {print $2; exit}' /proc/meminfo)
    [ "${mem_kb:-0}" -ge 262144 ] || die "RAM kurang dari 256 MB. Reinstall dibatalkan."

    disk_avail=$(df --output=avail / 2>/dev/null | tail -1 | tr -d ' ')
    [ "${disk_avail:-0}" -ge 1048576 ] || die "Ruang disk kosong terlalu kecil. Reinstall dibatalkan."

    ip route get 1.1.1.1 >/dev/null 2>&1 || die "Default route IPv4 tidak terdeteksi."
}

download_reinstall() {
    echo "Mengunduh reinstall.sh resmi..."
    curl -fL --retry 3 --connect-timeout 15 --max-time 120 \
        "$REINSTALL_URL" -o "$REINSTALL_FILE" || die "Gagal mengunduh reinstall.sh."

    [ -s "$REINSTALL_FILE" ] || die "reinstall.sh kosong."
    grep -q 'SCRIPT_VERSION\|usage_and_exit\|reinstall' "$REINSTALL_FILE" \
        || die "File reinstall.sh tidak terlihat seperti script upstream yang valid."

    chmod 700 "$REINSTALL_FILE"
}

run_reinstall_safe() {
    local os="$1" ver="$2"
    check_rebuild_environment
    download_reinstall

    echo
    echo "============================================================"
    echo " PERINGATAN: INI AKAN MENGHAPUS SISTEM/DISK SAAT REINSTALL"
    echo " Target : ${os} ${ver}"
    echo " Network: $(ip -4 route show default 2>/dev/null | head -1)"
    echo "============================================================"
    read -r -p "Ketik REINSTALL untuk melanjutkan: " confirm
    [ "$confirm" = "REINSTALL" ] || { echo "Dibatalkan."; return 1; }

    bash "$REINSTALL_FILE" "$os" "$ver" 2>&1 | tee -a "$REBUILD_LOG"
}
# ======================= END SAFE REBUILD GUARD =======================

