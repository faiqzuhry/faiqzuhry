  read -p "Pilihan OS Kamu: " os_choice
  case $os_choice in
    1) handle_debian ;;
    2) handle_ubuntu ;;
    3) handle_change_source_list ;;
    x) exit 0 ;;
    *) echo "Pilihan tidak valid, coba lagi." ;;
  esac
done
