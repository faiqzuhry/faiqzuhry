# Function to change source list for Debian 13 (Trixie)
change_source_list_debian13() {
  set -e
  local backup="/etc/apt/sources.list.backup.$(date +%Y%m%d-%H%M%S)"
  [ -f /etc/apt/sources.list ] && cp -a /etc/apt/sources.list "$backup"
  mkdir -p /etc/apt/sources.list.d
  for f in /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
    [ -e "$f" ] || continue
    case "$f" in
      */debian.sources) ;;
      *) mv "$f" "$f.disabled" ;;
    esac
  done
  : >/etc/apt/sources.list
  cat >/etc/apt/sources.list.d/debian.sources <<'EOF'
Types: deb
URIs: https://deb.debian.org/debian
Suites: trixie trixie-updates
Components: main non-free-firmware contrib non-free
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: https://security.debian.org/debian-security
Suites: trixie-security
Components: main non-free-firmware contrib non-free
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
  apt-get update
  echo "Debian 13 (trixie) native sources configured."
}

# Debian 13 native rebuild. The official reinstall script is used, with its
# Debian preseed patched locally so timezone and final APT sources are native.
rebuild_debian13_native() {
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y curl python3
  curl -fsSL -o reinstall.sh https://raw.githubusercontent.com/bin456789/reinstall/main/reinstall.sh
  curl -fsSL -o /tmp/faiq-debian13.cfg https://raw.githubusercontent.com/bin456789/reinstall/main/debian.cfg

  # Force the downloaded installer to use our locally patched preseed file.

  python3 - <<'PYIN'
from pathlib import Path
p=Path('/tmp/faiq-debian13.cfg')
s=p.read_text()
start=s.find('d-i preseed/late_command string')
needle='    in-target systemctl enable fix-eth-name'
if start >= 0 and needle in s[start:] and 'trixie-updates' not in s[start:]:
    patch="""    mkdir -p /target/etc/apt/sources.list.d; \\
    : >/target/etc/apt/sources.list; \\
    printf '%s\\n' 'Types: deb' 'URIs: https://deb.debian.org/debian' 'Suites: trixie trixie-updates' 'Components: main non-free-firmware contrib non-free' 'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' '' 'Types: deb' 'URIs: https://security.debian.org/debian-security' 'Suites: trixie-security' 'Components: main non-free-firmware contrib non-free' 'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' > /target/etc/apt/sources.list.d/debian.sources; \\
"""
    s=s.replace(needle,patch+needle,1)
p.write_text(s)
PYIN

  chmod +x reinstall.sh
  echo "Starting Debian 13 (trixie) native rebuild..."
  run_reinstall_safe debian 13
}

